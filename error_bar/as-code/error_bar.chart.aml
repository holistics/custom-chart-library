CustomChartDef error_bar {
  label: 'Error Bar'
  icon: 'hicon:chart-boxplot'
  description: 'To visualize the uncertainty or degree of error in a reported measurement across categories.'
  fields {
    field value {
      label: 'Value'
      type: 'dimension'
      data_type: 'number'
      sort {
        apply_order: 1
        direction: 'asc'
      }
    }
    field dimension {
      label: 'Dimension'
      type: 'dimension'
      sort {
        apply_order: 2
        direction: 'asc'
      }
    }
  }

  options {
    option extent {
      type: 'select'
      label: 'Error extent'
      options: [
        'ci',
        'stderr',
        'stdev',
        'iqr'
      ]
      default_value: 'ci'
    }
  }

  template: @vgl {
    "data": {
      "values": @{values}
    },
    "transform": [
      {"filter": "isValid(datum['@{fields.value.name}'])"},
      {
        "aggregate": [
          {"op": "mean", "field": @{fields.value.name}, "as": "center"},
          {"op": "count", "field": @{fields.value.name}, "as": "n"},
          {"op": "stdev", "field": @{fields.value.name}, "as": "stdev"},
          {"op": "ci0", "field": @{fields.value.name}, "as": "ci_lower"},
          {"op": "ci1", "field": @{fields.value.name}, "as": "ci_upper"},
          {"op": "q1", "field": @{fields.value.name}, "as": "iqr_lower"},
          {"op": "q3", "field": @{fields.value.name}, "as": "iqr_upper"}
        ],
        "groupby": [@{fields.dimension.name}]
      },
      {"calculate": "datum.stdev / sqrt(datum.n)", "as": "stderr"},
      {"calculate": "datum.center - datum.stdev", "as": "stdev_lower"},
      {"calculate": "datum.center + datum.stdev", "as": "stdev_upper"},
      {"calculate": "datum.center - datum.stderr", "as": "stderr_lower"},
      {"calculate": "datum.center + datum.stderr", "as": "stderr_upper"},
      {"calculate": "'@{options.extent.value}' === 'ci' ? datum.ci_lower : '@{options.extent.value}' === 'stderr' ? datum.stderr_lower : '@{options.extent.value}' === 'stdev' ? datum.stdev_lower : datum.iqr_lower", "as": "lower"},
      {"calculate": "'@{options.extent.value}' === 'ci' ? datum.ci_upper : '@{options.extent.value}' === 'stderr' ? datum.stderr_upper : '@{options.extent.value}' === 'stdev' ? datum.stdev_upper : datum.iqr_upper", "as": "upper"}
    ],
    "encoding": {
      "y": {
        "field": @{fields.dimension.name},
        "type": "ordinal"
      }
    },
    "layer": [
      {
        "mark": {"type": "rule", "color": "oklch(0.7 0.01 185)", "strokeWidth": 1.5},
        "encoding": {
          "x": {"field": "lower", "type": "quantitative", "scale": {"zero": false}, "axis": {"format": @{fields.value.format}, "formatType": "holisticsFormat"}},
          "x2": {"field": "upper"},
          "tooltip": [
            {"field": @{fields.dimension.name}, "type": "nominal", "title": "Category"}
          ],
          "opacity": {"condition": [{"test": "!length(data('error_hover_store'))", "value": 1}, {"param": "error_hover", "empty": false, "value": 1}], "value": 0.15}
        }
      },
      {
        "mark": {"type": "tick", "color": "oklch(0.7 0.01 185)", "size": 12, "thickness": 1.5},
        "encoding": {
          "x": {"field": "lower", "type": "quantitative", "scale": {"zero": false}},
          "tooltip": [
            {"field": @{fields.dimension.name}, "type": "nominal", "title": "Category"}
          ],
          "opacity": {"condition": [{"test": "!length(data('error_hover_store'))", "value": 1}, {"param": "error_hover", "empty": false, "value": 1}], "value": 0.15}
        }
      },
      {
        "mark": {"type": "tick", "color": "oklch(0.7 0.01 185)", "size": 12, "thickness": 1.5},
        "encoding": {
          "x": {"field": "upper", "type": "quantitative", "scale": {"zero": false}},
          "tooltip": [
            {"field": @{fields.dimension.name}, "type": "nominal", "title": "Category"}
          ],
          "opacity": {"condition": [{"test": "!length(data('error_hover_store'))", "value": 1}, {"param": "error_hover", "empty": false, "value": 1}], "value": 0.15}
        }
      },
      {
        "params": [
          {"name": "error_hover", "select": {"type": "point", "fields": [@{fields.dimension.name}], "on": "mouseover", "clear": "mouseout"}},
          {"name": "normalPointSelection", "select": {"type": "point", "toggle": "true", "clear": "mouseup"}},
          {"name": "hoverPointSelection", "select": {"type": "point", "on": "mouseover", "clear": "mouseout"}}
        ],
        "mark": {"type": "point", "filled": true, "size": 150},
        "encoding": {
          "x": {"field": "center", "type": "quantitative", "scale": {"zero": false}},
          "tooltip": [
            {"field": @{fields.dimension.name}, "type": "nominal", "title": "Category"},
            {"field": "center", "type": "quantitative", "title": "Mean", "format": @{fields.value.format}, "formatType": "holisticsFormat"}
          ],
          "opacity": {"condition": [{"test": "!length(data('error_hover_store'))", "value": 1}, {"param": "error_hover", "empty": false, "value": 1}], "value": 0.15}
        }
      }
    ],
    "holisticsConfig": {
      "crossFilterSignals": ["normalPointSelection"],
      "contextMenuSignals": ["hoverPointSelection"]
    }
  };;
}
