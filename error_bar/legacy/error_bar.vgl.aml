CustomChart {
  fields {
    field point {
      type: "dimension"
      label: "Points"
    }
    field variety {
      type: "dimension"
      label: "Variety"
    }
  }
  template: @vgl
  {
      "data": {
        "values": @{values}
      },
      "layer": [
        {
          "mark": {
            "type": "point",
            "filled": true
          },
          "encoding": {
            "x": {
              "type": "quantitative",
              "field": @{fields.point.name},
              "scale": {
                "zero": false
              },
              "title": "Barley Yield",
              "aggregate": "mean"
            },
            "color": {
              "value": "black"
            }
          }
        },
        {
          "mark": {
            "type": "errorbar",
            "extent": "ci"
          },
          "encoding": {
            "x": {
              "type": "quantitative",
              "field": @{fields.point.name},
              "title": "Barley Yield"
            }
          }
        }
      ],
      "encoding": {
        "y": {
          "type": "ordinal",
          "field": @{fields.variety.name}
        }
      }
    }
  ;;;
}
